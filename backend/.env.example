# Required in production (Render generates JWT_SECRET automatically).
JWT_SECRET=change-me-to-a-long-random-string

# SQLite location. On Render's free plan this is ephemeral and resets on deploy.
SQLITE_PATH=./data/rashify.db

# Seeded admin account (username or email works on the login form).
ADMIN_EMAIL=admin@rashisense.com
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Rashi@2026

# Optional. Without it, deterministic horoscope/gemstone fallbacks are used.
# EMERGENT_LLM_KEY=

# Display price shown in the UI. PDF download is free in this deployment.
PDF_PRICE_INR=0

# Comma-separated allowed origins. Same-origin deploy can use *.
CORS_ORIGINS=*
